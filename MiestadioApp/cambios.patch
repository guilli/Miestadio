+
+        <TouchableOpacity style={styles.homeBtn} onPress={() => navigation.goBack()}>
+          <Text style={styles.homeBtnText}>🏠 Volver al inicio</Text>
+        </TouchableOpacity>
+      </ScrollView>
+    </View>
+  );
+};
