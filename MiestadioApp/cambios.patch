+        {/* Selector de Liga */}
+        <View style={styles.pickerRow}>
+          <Text style={styles.pickerLabel}>Liga</Text>
+          <View style={styles.pickerBox}>
+            <Picker
+              selectedValue={selectedLeagueId}
+              onValueChange={v => setSelectedLeagueId(v as LeagueId)}
+              style={styles.picker}
