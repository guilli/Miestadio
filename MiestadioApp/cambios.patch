+            </View>
+          </View>
+
+          {/* Feedback + botón siguiente */}
+          {answered && (
+            <View style={styles.feedbackArea}>
+              <Text style={styles.feedbackText}>
+                {selectedOption === currentQuestion.correctAnswer
